    )

    # Quick side-by-side comparison
    print("\n\n=== Comparison ===")
    print(f"{'Metric':<10}{'Dataset1':>12}{'Dataset2':>12}")
    for k in ["rmse", "mae", "r2", "mape"]:
        print(f"{k.upper():<10}{results_1[k]:>12.3f}{results_2[k]:>12.3f}")