        name="Water Compliance Dataset",
        year_col="year",   # <-- confirm this matches your actual column name
    )

    results_2 = run_ann_pipeline(
        csv_path="/Users/cosmic/Downloads/Feature_CSVs/water_drought_features_county_week_2010_2024.csv",     # <-- change to your file path
        target_col="target_drought_severity_0_100",         # <-- change to your 0-100 target column name
        name="Water Drought Dataset",
