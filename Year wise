"""
ANN Regression Pipeline for Water-Related Datasets (Output scale: 0-100)
==========================================================================

Uses scikit-learn's MLPRegressor (a feed-forward ANN) instead of TensorFlow,
since TensorFlow does not yet support newer Python versions (e.g. 3.14).
scikit-learn is pure Python + numpy, so it installs cleanly everywhere.

This script defines ONE reusable pipeline function `run_ann_pipeline()` that you
call twice — once per dataset. Each call trains its own model, so the two
datasets never mix.

Data is split by YEAR (not randomly) to avoid leaking future information into
training — the model trains on earlier years and is validated/tested on
later years, which is the realistic way to evaluate a forecasting model.

Requirements:
    pip install scikit-learn pandas numpy matplotlib joblib

Usage:
    python ann_water_pipeline.py

Or import and call from your own notebook/script:
    from ann_water_pipeline import run_ann_pipeline
    results_1 = run_ann_pipeline("dataset1.csv", target_col="WQI", name="Dataset1", year_col="year")
    results_2 = run_ann_pipeline("dataset2.csv", target_col="WQI", name="Dataset2", year_col="year")
"""

import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import joblib

from sklearn.preprocessing import MinMaxScaler
from sklearn.neural_network import MLPRegressor
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score

# ---------------------------------------------------------------------------
# Reproducibility
# ---------------------------------------------------------------------------
SEED = 42
np.random.seed(SEED)


def run_ann_pipeline(
    csv_path,
    target_col,
    name="Dataset",
    feature_cols=None,
    year_col="year",
    n_train_years=5,
    n_val_years=2,
    n_test_years=3,
    hidden_layers=(128, 64, 32),
    lr=1e-3,
    max_epochs=2000,
    patience=20,
    output_dir="outputs",
):
    """
    Full pipeline: load -> clean -> split by year -> scale -> train ANN ->
    evaluate on val + test -> save model bundle.

    Parameters
    ----------
    csv_path : str            path to the dataset CSV
    target_col : str          name of the column holding the 0-100 target value
    name : str                label used in printed output / saved file names
    feature_cols : list|None  which columns to use as inputs; None = all numeric except target/year
    year_col : str            name of the column holding the year value
    n_train_years : int       number of most-recent years to use for training
    n_val_years : int         number of years (after train years) to use for validation
    n_test_years : int        number of years (most recent) to use for testing
    """
    print(f"\n{'='*60}\nRunning pipeline for: {name}\n{'='*60}")

    # 1. Load ------------------------------------------------------------
    df = pd.read_csv(csv_path)
    df = df.dropna()  # simplest approach; swap for imputation if you need it

    if year_col not in df.columns:
        raise ValueError(
            f"year_col='{year_col}' not found in columns: {df.columns.tolist()}"
        )

    if feature_cols is None:
        candidate_cols = [c for c in df.columns if c not in [target_col, year_col]]
        numeric_cols = [c for c in candidate_cols if pd.api.types.is_numeric_dtype(df[c])]
        dropped_cols = [c for c in candidate_cols if c not in numeric_cols]
        if dropped_cols:
            print(f"  Dropping {len(dropped_cols)} non-numeric column(s) from features: {dropped_cols}")
        feature_cols = numeric_cols

    # 2. Year-based split --------------------------------------------------
    all_years = sorted(df[year_col].unique())
    needed = n_train_years + n_val_years + n_test_years

    if len(all_years) < needed:
        raise ValueError(
            f"Need {needed} years but only {len(all_years)} available: {all_years}"
        )

    # Use the most recent `needed` years, in chronological order
    recent_years = all_years[-needed:]
    train_years = recent_years[:n_train_years]
    val_years = recent_years[n_train_years: n_train_years + n_val_years]
    test_years = recent_years[n_train_years + n_val_years:]

    if len(all_years) > needed:
        unused_years = all_years[:-needed]
        print(f"  NOTE: {len(unused_years)} older year(s) unused: {unused_years}")

    print(f"  Train years: {train_years}")
    print(f"  Val years  : {val_years}")
    print(f"  Test years : {test_years}")

    train_df = df[df[year_col].isin(train_years)]
    val_df = df[df[year_col].isin(val_years)]
    test_df = df[df[year_col].isin(test_years)]

    X_train_raw = train_df[feature_cols].values.astype(float)
    y_train_raw = train_df[target_col].values.astype(float)
    X_val_raw = val_df[feature_cols].values.astype(float)
    y_val_raw = val_df[target_col].values.astype(float)
    X_test_raw = test_df[feature_cols].values.astype(float)
    y_test_raw = test_df[target_col].values.astype(float)

    if y_train_raw.min() < 0 or y_train_raw.max() > 100:
        print(f"  WARNING: target values outside 0-100 range in training data "
              f"(min={y_train_raw.min():.2f}, max={y_train_raw.max():.2f}). "
              f"Check your data or clip/rescale it before training.")

    # 3. Scale — fit on TRAIN ONLY, apply to val/test ----------------------
    # Fitting scalers on the full dataset would leak future-year information
    # into training, so we fit only on the training years.
    x_scaler = MinMaxScaler()
    X_train = x_scaler.fit_transform(X_train_raw)
    X_val = x_scaler.transform(X_val_raw)
    X_test = x_scaler.transform(X_test_raw)

    y_scaler = MinMaxScaler(feature_range=(0, 1))
    y_train = y_scaler.fit_transform(y_train_raw.reshape(-1, 1)).flatten()
    y_val = y_scaler.transform(y_val_raw.reshape(-1, 1)).flatten()
    y_test = y_scaler.transform(y_test_raw.reshape(-1, 1)).flatten()

    print(f"  Train: {X_train.shape[0]}  Val: {X_val.shape[0]}  Test: {X_test.shape[0]}  "
          f"Features: {X_train.shape[1]}")

    # 4. Build + train model ------------------------------------------------
    model = MLPRegressor(
        hidden_layer_sizes=hidden_layers,
        activation="relu",
        solver="adam",
        learning_rate_init=lr,
        max_iter=max_epochs,
        early_stopping=True,          # uses an internal split of the TRAIN set to stop
        n_iter_no_change=patience,
        validation_fraction=0.15,
        random_state=SEED,
    )

    model.fit(X_train, y_train)
    print(f"  Trained for {model.n_iter_} iterations "
          f"(early stopping patience={patience})")

    # 5. Evaluate on the year-based VALIDATION set --------------------------
    y_val_pred_scaled = model.predict(X_val)
    y_val_pred = y_scaler.inverse_transform(y_val_pred_scaled.reshape(-1, 1)).flatten()
    y_val_true = y_scaler.inverse_transform(y_val.reshape(-1, 1)).flatten()
    y_val_pred = np.clip(y_val_pred, 0, 100)

    val_rmse = np.sqrt(mean_squared_error(y_val_true, y_val_pred))
    val_mae = mean_absolute_error(y_val_true, y_val_pred)
    val_r2 = r2_score(y_val_true, y_val_pred)

    print(f"\n  --- {name} Validation Set Metrics (years {val_years}) ---")
    print(f"  RMSE: {val_rmse:.3f}  MAE: {val_mae:.3f}  R^2: {val_r2:.4f}")

    # 6. Evaluate on the year-based TEST set ---------------------------------
    y_pred_scaled = model.predict(X_test)
    y_pred = y_scaler.inverse_transform(y_pred_scaled.reshape(-1, 1)).flatten()
    y_true = y_scaler.inverse_transform(y_test.reshape(-1, 1)).flatten()
    y_pred = np.clip(y_pred, 0, 100)  # keep predictions on the valid 0-100 scale

    rmse = np.sqrt(mean_squared_error(y_true, y_pred))
    mae = mean_absolute_error(y_true, y_pred)
    r2 = r2_score(y_true, y_pred)
    mape = np.mean(np.abs((y_true - y_pred) / np.clip(y_true, 1e-6, None))) * 100
    nrmse = rmse / (y_true.max() - y_true.min()) * 100  # RMSE as % of range, since scale is fixed 0-100

    print(f"\n  --- {name} Test Set Metrics (years {test_years}) ---")
    print(f"  RMSE      : {rmse:.3f}")
    print(f"  MAE       : {mae:.3f}")
    print(f"  R^2       : {r2:.4f}")
    print(f"  MAPE      : {mape:.2f}%")
    print(f"  NRMSE     : {nrmse:.2f}% (RMSE relative to 0-100 scale)")

    # 7. Save model + scalers + feature columns as one bundle ----------------
    os.makedirs(output_dir, exist_ok=True)
    bundle_path = os.path.join(output_dir, f"{name.replace(' ', '_')}_ann_model.joblib")

    joblib.dump({
        "model": model,
        "x_scaler": x_scaler,
        "y_scaler": y_scaler,
        "feature_cols": feature_cols,
        "train_years": train_years,
        "val_years": val_years,
        "test_years": test_years,
    }, bundle_path)

    print(f"  Saved model bundle to: {bundle_path}")

    # 8. Return results for comparison / later use ----------------------------
    return {
        "rmse": rmse,
        "mae": mae,
        "r2": r2,
        "mape": mape,
        "nrmse": nrmse,
        "val_rmse": val_rmse,
        "val_mae": val_mae,
        "val_r2": val_r2,
        "model": model,
        "bundle_path": bundle_path,
    }


if __name__ == "__main__":
    # ------------------------------------------------------------------
    # EDIT THESE for your two datasets, then run: python ann_water_pipeline.py
    # ------------------------------------------------------------------
