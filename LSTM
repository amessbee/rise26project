"""
RNN / LSTM (PyTorch) Pipeline + ANOVA Feature Selection
=========================================================

Companion to ann_water_pipeline.py. Adds:

1. ANOVA feature selection (sklearn's f_regression) -- tests each numeric
   feature against the continuous target to find which ones have a
   statistically significant linear relationship with it.

2. RNN and LSTM models (PyTorch) -- unlike the MLPRegressor in the other
   script, these look at a WINDOW of consecutive time steps to make a
   prediction, rather than treating each row independently.

IMPORTANT ASSUMPTION -- READ THIS:
   RNN/LSTM sequences only make sense if consecutive rows in your data
   actually represent consecutive time steps for the SAME entity (e.g. the
   same water system or county across years/weeks). If your CSV has
   multiple entities per year, you MUST set `group_col` to whatever column
   identifies the entity (e.g. "system_id", "county"), or the sequences
   will mix unrelated entities together and the model will learn garbage
   patterns. If you don't have an entity column, sequences are built by
   just sorting the whole dataset by time, which is only meaningful if
   there truly is one row per time step.

Requirements:
    pip install torch scikit-learn pandas numpy joblib
"""

import os
import numpy as np
import pandas as pd
import joblib

from sklearn.preprocessing import MinMaxScaler
from sklearn.feature_selection import f_regression
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score

import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader

SEED = 42
np.random.seed(SEED)
torch.manual_seed(SEED)


# ---------------------------------------------------------------------------
# ANOVA feature selection
# ---------------------------------------------------------------------------
def run_anova_feature_selection(df, feature_cols, target_col, alpha=0.05, name="Dataset"):
    """
    Runs an ANOVA F-test (sklearn's f_regression) between each feature and a
    continuous target, one feature at a time. This is the regression version
    of ANOVA -- it tells you which features have a statistically significant
    linear relationship with the target on their own (not accounting for
    interactions between features).

    Returns
    -------
    results : DataFrame with feature, f_score, p_value, sorted by p_value
    significant : list of feature names with p_value < alpha
    """
    X = df[feature_cols].values.astype(float)
    y = df[target_col].values.astype(float)

    f_scores, p_values = f_regression(X, y)

    results = pd.DataFrame({
        "feature": feature_cols,
        "f_score": f_scores,
        "p_value": p_values,
    }).sort_values("p_value").reset_index(drop=True)

    significant = results.loc[results["p_value"] < alpha, "feature"].tolist()

    print(f"\n{'='*60}\nANOVA Feature Selection: {name}\n{'='*60}")
    print(results.to_string(index=False))
    print(f"\n  {len(significant)}/{len(feature_cols)} features significant at alpha={alpha}")
    print(f"  Significant features: {significant}")

    return results, significant


# ---------------------------------------------------------------------------
# Sequence building for RNN / LSTM
# ---------------------------------------------------------------------------
class SequenceDataset(Dataset):
    """Wraps arrays of shape (n_sequences, seq_len, n_features) / (n_sequences,)."""

    def __init__(self, X_seqs, y_seqs):
        self.X = torch.tensor(X_seqs, dtype=torch.float32)
        self.y = torch.tensor(y_seqs, dtype=torch.float32)

    def __len__(self):
        return len(self.X)

    def __getitem__(self, idx):
        return self.X[idx], self.y[idx]


def build_sequences(df, feature_cols, target_col, seq_len, group_col=None, time_cols=("year",)):
    """
    Turns a flat table into (X_seqs, y_seqs) for RNN/LSTM training.

    Each sequence is `seq_len` consecutive time steps of features; the target
    is the value immediately following that window.

    group_col : column identifying an entity (e.g. county, water system id).
                Sequences are built separately per entity so time steps from
                different entities never get mixed into the same window.
                If None, the whole dataframe is treated as a single sequence
                (only correct if there is truly one row per time step).
    time_cols : column(s) used to sort rows chronologically within a group.
    """
    sort_cols = ([group_col] if group_col else []) + list(time_cols)
    df_sorted = df.sort_values(sort_cols).reset_index(drop=True)

    X_all = df_sorted[feature_cols].values.astype(float)
    y_all = df_sorted[target_col].values.astype(float)
    groups = df_sorted[group_col].values if group_col else np.zeros(len(df_sorted))

    X_seqs, y_seqs = [], []
    for g in np.unique(groups):
        idx = np.where(groups == g)[0]
        X_g, y_g = X_all[idx], y_all[idx]
        for i in range(len(X_g) - seq_len):
            X_seqs.append(X_g[i:i + seq_len])
            y_seqs.append(y_g[i + seq_len])

    if len(X_seqs) == 0:
        raise ValueError(
            f"No sequences could be built with seq_len={seq_len}. "
            f"Each group needs more than {seq_len} rows -- try a shorter "
            f"seq_len or check that group_col/time_cols are set correctly."
        )

    return np.array(X_seqs), np.array(y_seqs)


# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
class RNNRegressor(nn.Module):
    def __init__(self, input_size, hidden_size=32, num_layers=1):
        super().__init__()
        self.rnn = nn.RNN(input_size, hidden_size, num_layers, batch_first=True)
        self.fc = nn.Linear(hidden_size, 1)

    def forward(self, x):
        out, _ = self.rnn(x)
        out = out[:, -1, :]  # last time step's hidden state
        return self.fc(out).squeeze(-1)


class LSTMRegressor(nn.Module):
    def __init__(self, input_size, hidden_size=32, num_layers=1):
        super().__init__()
        self.lstm = nn.LSTM(input_size, hidden_size, num_layers, batch_first=True)
        self.fc = nn.Linear(hidden_size, 1)

    def forward(self, x):
        out, _ = self.lstm(x)
        out = out[:, -1, :]
        return self.fc(out).squeeze(-1)


# ---------------------------------------------------------------------------
# Training loop shared by RNN and LSTM
# ---------------------------------------------------------------------------
def train_torch_model(model, train_loader, val_loader, lr=1e-3, max_epochs=200, patience=15, device="cpu"):
    model.to(device)
    optimizer = torch.optim.Adam(model.parameters(), lr=lr)
    loss_fn = nn.MSELoss()

    best_val_loss = float("inf")
    best_state = None
    epochs_no_improve = 0

    for epoch in range(max_epochs):
        model.train()
        for X_batch, y_batch in train_loader:
            X_batch, y_batch = X_batch.to(device), y_batch.to(device)
            optimizer.zero_grad()
            preds = model(X_batch)
            loss = loss_fn(preds, y_batch)
            loss.backward()
            optimizer.step()

        model.eval()
        val_losses = []
        with torch.no_grad():
            for X_batch, y_batch in val_loader:
                X_batch, y_batch = X_batch.to(device), y_batch.to(device)
                preds = model(X_batch)
                val_losses.append(loss_fn(preds, y_batch).item())
        val_loss = float(np.mean(val_losses)) if val_losses else float("inf")

        if val_loss < best_val_loss:
            best_val_loss = val_loss
            best_state = {k: v.clone() for k, v in model.state_dict().items()}
            epochs_no_improve = 0
        else:
            epochs_no_improve += 1
            if epochs_no_improve >= patience:
                print(f"    Early stopping at epoch {epoch + 1} (best val_loss={best_val_loss:.5f})")
                break

    if best_state is not None:
        model.load_state_dict(best_state)

    return model, best_val_loss


# ---------------------------------------------------------------------------
# Full RNN + LSTM pipeline (with ANOVA feature selection up front)
# ---------------------------------------------------------------------------
def run_rnn_lstm_pipeline(
    csv_path,
    target_col,
    name="Dataset",
    feature_cols=None,
    year_col="year",
    group_col=None,
    time_cols=None,
    n_train_years=5,
    n_val_years=2,
    n_test_years=3,
    seq_len=3,
    hidden_size=32,
    num_layers=1,
    lr=1e-3,
    max_epochs=200,
    patience=15,
    batch_size=32,
    output_dir="outputs",
    anova_alpha=0.05,
    use_anova_features=True,
):
    print(f"\n{'='*60}\nRNN/LSTM Pipeline: {name}\n{'='*60}")

    df = pd.read_csv(csv_path)
    df = df.dropna()

    if year_col not in df.columns:
        raise ValueError(f"year_col='{year_col}' not found in columns: {df.columns.tolist()}")

    if feature_cols is None:
        exclude = {target_col, year_col}
        if group_col:
            exclude.add(group_col)
        candidate_cols = [c for c in df.columns if c not in exclude]
        feature_cols = [c for c in candidate_cols if pd.api.types.is_numeric_dtype(df[c])]

    # --- ANOVA feature selection ---
    _, significant_features = run_anova_feature_selection(
        df, feature_cols, target_col, alpha=anova_alpha, name=name
    )
    if use_anova_features and significant_features:
        print(f"  Using {len(significant_features)} ANOVA-significant features for RNN/LSTM training.")
        feature_cols = significant_features
    else:
        print(f"  Using all {len(feature_cols)} candidate features (ANOVA filtering off or nothing significant).")

    # --- Year-based split (same logic as the MLP pipeline) ---
    all_years = sorted(df[year_col].unique())
    needed = n_train_years + n_val_years + n_test_years
    if len(all_years) < needed:
        raise ValueError(f"Need {needed} years but only {len(all_years)} available: {all_years}")

    recent_years = all_years[-needed:]
    train_years = recent_years[:n_train_years]
    val_years = recent_years[n_train_years: n_train_years + n_val_years]
    test_years = recent_years[n_train_years + n_val_years:]

    print(f"  Train years: {train_years}")
    print(f"  Val years  : {val_years}")
    print(f"  Test years : {test_years}")

    train_df = df[df[year_col].isin(train_years)].copy()
    val_df = df[df[year_col].isin(val_years)].copy()
    test_df = df[df[year_col].isin(test_years)].copy()

    # --- Scale (fit on train only) ---
    x_scaler = MinMaxScaler()
    y_scaler = MinMaxScaler()

    train_df[feature_cols] = x_scaler.fit_transform(train_df[feature_cols].values.astype(float))
    val_df[feature_cols] = x_scaler.transform(val_df[feature_cols].values.astype(float))
    test_df[feature_cols] = x_scaler.transform(test_df[feature_cols].values.astype(float))

    train_df[[target_col]] = y_scaler.fit_transform(train_df[[target_col]].values.astype(float))
    val_df[[target_col]] = y_scaler.transform(val_df[[target_col]].values.astype(float))
    test_df[[target_col]] = y_scaler.transform(test_df[[target_col]].values.astype(float))

    # --- Build sequences ---
    sort_time_cols = time_cols if time_cols else [year_col]
    X_train_seq, y_train_seq = build_sequences(train_df, feature_cols, target_col, seq_len, group_col, sort_time_cols)
    X_val_seq, y_val_seq = build_sequences(val_df, feature_cols, target_col, seq_len, group_col, sort_time_cols)
    X_test_seq, y_test_seq = build_sequences(test_df, feature_cols, target_col, seq_len, group_col, sort_time_cols)

    print(f"  Sequences -> Train: {len(X_train_seq)}  Val: {len(X_val_seq)}  Test: {len(X_test_seq)}  "
          f"(seq_len={seq_len}, features={len(feature_cols)})")

    train_loader = DataLoader(SequenceDataset(X_train_seq, y_train_seq), batch_size=batch_size, shuffle=True)
    val_loader = DataLoader(SequenceDataset(X_val_seq, y_val_seq), batch_size=batch_size)
    test_loader = DataLoader(SequenceDataset(X_test_seq, y_test_seq), batch_size=batch_size)

    device = "cuda" if torch.cuda.is_available() else "cpu"

    results = {}
    for model_type, ModelClass in [("RNN", RNNRegressor), ("LSTM", LSTMRegressor)]:
        print(f"\n  --- Training {model_type} ---")
        torch.manual_seed(SEED)
        model = ModelClass(input_size=len(feature_cols), hidden_size=hidden_size, num_layers=num_layers)
        model, best_val_loss = train_torch_model(
            model, train_loader, val_loader, lr=lr, max_epochs=max_epochs, patience=patience, device=device
        )

        model.eval()
        preds_scaled, trues_scaled = [], []
        with torch.no_grad():
            for X_batch, y_batch in test_loader:
                X_batch = X_batch.to(device)
                preds_scaled.append(model(X_batch).cpu().numpy())
                trues_scaled.append(y_batch.numpy())
        preds_scaled = np.concatenate(preds_scaled)
        trues_scaled = np.concatenate(trues_scaled)

        preds = y_scaler.inverse_transform(preds_scaled.reshape(-1, 1)).flatten()
        trues = y_scaler.inverse_transform(trues_scaled.reshape(-1, 1)).flatten()
        preds = np.clip(preds, 0, 100)

        rmse = np.sqrt(mean_squared_error(trues, preds))
        mae = mean_absolute_error(trues, preds)
        r2 = r2_score(trues, preds)

        print(f"  {model_type} Test Metrics -- RMSE: {rmse:.3f}  MAE: {mae:.3f}  R^2: {r2:.4f}")

        os.makedirs(output_dir, exist_ok=True)
        model_path = os.path.join(output_dir, f"{name.replace(' ', '_')}_{model_type.lower()}_model.pt")
        torch.save({
            "model_state_dict": model.state_dict(),
            "model_type": model_type,
            "input_size": len(feature_cols),
            "hidden_size": hidden_size,
            "num_layers": num_layers,
            "seq_len": seq_len,
            "feature_cols": feature_cols,
            "x_scaler": x_scaler,
            "y_scaler": y_scaler,
            "train_years": train_years,
            "val_years": val_years,
            "test_years": test_years,
        }, model_path)
        print(f"  Saved {model_type} bundle to: {model_path}")

        results[model_type] = {"rmse": rmse, "mae": mae, "r2": r2, "model_path": model_path}

    return results


